{
  "name": "sdk-internal-integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:test": "bash ../build.sh && npm run test",
    "test": "npm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "perf": "vitest bench --run",
    "perf:profile": "vitest bench --run --execArgv=--cpu-prof --execArgv=--cpu-prof-dir=perf/profiles"
  },
  "dependencies": {
    "@bitwarden/sdk-internal": "file:../npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
