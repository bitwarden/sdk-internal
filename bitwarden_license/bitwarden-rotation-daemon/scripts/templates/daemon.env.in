# Environment for bw-rotation-daemon, read by systemd. Root-owned, mode 0400.
#
# Per-target credentials go here, keyed by target system UUID: uppercase the UUID,
# replace hyphens with underscores, append the suffix.
#
#   Entra         TENANT_ID, CLIENT_ID, CLIENT_SECRET
#   CustomScript  SCRIPT
#
# Any other variable with the same prefix reaches a custom script as
# credentials.<SUFFIX> in its stdin JSON:
#
#   85808642_BABA_4B8E_8C34_B48000D60A0A_SCRIPT=@SCRIPT_ROOT@/rotate.sh
#   85808642_BABA_4B8E_8C34_B48000D60A0A_ADMIN_TOKEN=...
#
# Names starting with a digit are fine: systemd sets them without a shell. Do not try
# to 'source' this file. Restart the service after editing.

BWRD_TOKEN=@TOKEN@
