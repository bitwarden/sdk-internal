// Example: Bob sends a symmetric key to Alice under her public key.
// See example.md.

attacker[active]

principal Alice[
	generates sk_alice
	pk_alice = PUBKEY(sk_alice)
]

// Alice publishes her public key. Unguarded: the attacker can replace it.
Alice -> Bob: pk_alice

principal Bob[
	generates k
	e = PKE_ENC(pk_alice, k)
]

Bob -> Alice: e

principal Alice[
	k_dec = PKE_DEC(sk_alice, e)
]

queries[
	confidentiality? k
	authentication? Bob -> Alice: e
]
